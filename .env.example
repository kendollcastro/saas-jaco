# Database — PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Supabase — project URL and anon key
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Super admin emails (comma-separated)
SUPER_ADMIN_EMAILS="admin@example.com"

# Supabase service role key (admin API — keep secret!)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Site URL — used for CSRF origin validation
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PIN salt (legacy SHA-256 migration, not used for new hashes)
PIN_SALT="ola-portal-v1"
